{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.21/MicrosoftTeams.schema.json",
  "manifestVersion": "1.21",
  "version": "1.1.1",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Integrations IT Solutions",
    "websiteUrl": "https://www.integrations.at",
    "privacyUrl": "https://www.example.com/privacy",
    "termsOfUseUrl": "https://www.example.com/termofuse"
  },
  "icons": {
    "color": "weather-agent.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Declarative-Travel-Agent",
    "full": "VSCode Agent Toolkit Declarative Travel Agent"
  },
  "description": {
    "short": "Provides weather information and recommendations for Vienna.",
    "full": "This agent provides weather information and recommendations for places to visit in Vienna. It can answer questions about the current weather, upcoming events, and tourist attractions."
  },
  "accentColor": "#FFFFFF",
  "composeExtensions": [],
  "permissions": ["identity", "messageTeamMembers"],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "declarativeAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "validDomains": []
}
