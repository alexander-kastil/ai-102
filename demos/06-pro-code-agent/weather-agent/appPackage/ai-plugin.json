{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.1/schema.json",
  "schema_version": "v2.1",
  "name_for_human": "weather",
  "description_for_human": "Description for weather",
  "description_for_model": "Description for weather",
  "contact_email": "publisher-email@example.com",
  "namespace": "declarativeweatheragent",
  "capabilities": {
    "conversation_starters": []
  },
  "functions": [
    {
      "name": "GetWeatherForecast",
      "description": "Get the weather forecast for a specific city and date. The date must be in the format YYYY-MM-DD, ie 2025-07-10",
      "capabilities": {
        "response_semantics": {
          "data_path": "$",
          "static_template": {
            "file": "./adaptiveCards/GetWeatherForecast.json"
          }
        }
      }
    }
  ],
  "runtimes": [
    {
      "type": "OpenApi",
      "auth": {
        "type": "None"
      },
      "spec": {
        "url": "apiSpecificationFile/openapi.yaml"
      },
      "run_for_functions": ["GetWeatherForecast"]
    }
  ]
}
